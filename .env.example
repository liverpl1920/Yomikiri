# =============================================================
# .env.example — アプリケーション環境変数テンプレート
# このファイルをコピーして .env を作成してください。
# .env は .gitignore で管理対象外です。
# =============================================================

# ---------------------------
# Rails
# ---------------------------
RAILS_ENV=development
RAILS_MASTER_KEY=your_master_key_here

# ---------------------------
# データベース（ローカル開発）
# ---------------------------
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=

# 本番環境（Neon）
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/yomikiri?sslmode=require

# ---------------------------
# 本番環境 Render
# ---------------------------
# RAILS_LOG_TO_STDOUT=true
# RAILS_SERVE_STATIC_FILES=true

# ---------------------------
# 外部API
# ---------------------------
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here
RAKUTEN_APPLICATION_ID=your_rakuten_application_id_here

# ---------------------------
# メール設定
# ---------------------------
# MAILER_SENDER=noreply@yomikiri-app.com
