<%= form_with(model: book,
               multipart: true,
               html: { autocomplete: 'off' },
               data: {
                 controller: 'book-form'
               }) do |f| %>

  <%# バリデーションエラー一覧 %>
  <% if book.errors.any? %>
    <div class="form-errors" role="alert">
      <h2 class="form-errors__title">
        <%= book.errors.count %>件のエラーがあります
      </h2>
      <ul class="form-errors__list">
        <% book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# タイトル %>
  <div class="form-field" data-controller="title-autocomplete">
    <%= f.label :title, 'タイトル', class: 'form-field__label' %>
    <span class="form-field__required" aria-hidden="true">必須</span>
    <%= f.text_field :title,
          class: "form-field__input #{'form-field__input--error' if book.errors[:title].any?}",
          placeholder: '例: リーダブルコード',
          autocomplete: 'off',
          data: {
            'book-form-target': 'title',
            'title-autocomplete-target': 'input',
            action: 'input->title-autocomplete#onInput keydown->title-autocomplete#onKeydown'
          } %>
        <ul class="title-autocomplete__list title-autocomplete__list--hidden"
          data-title-autocomplete-target="list"
          role="listbox"
          aria-label="書籍候補"></ul>
        <% if book.errors[:title].any? %>
      <span class="form-field__error"><%= book.errors[:title].first %></span>
    <% end %>
    <p class="book-form__title-status" data-book-form-target="titleStatus" aria-live="polite"></p>
    <div class="book-cover-preview" data-book-form-target="coverPreview" hidden></div>
    <button type="button"
            class="btn btn--outline"
            data-action="click->book-form#fetchByTitle">
      情報取得
    </button>
  </div>

  <%# 著者 %>
  <div class="form-field">
    <%= f.label :author, '著者', class: 'form-field__label' %>
    <span class="form-field__optional">任意</span>
    <div class="form-field__input-row">
      <%= f.text_field :author,
            class: 'form-field__input',
            placeholder: '例: Dustin Boswell (複数いる場合はカンマ区切り)',
            autocomplete: 'off' %>
      <button type="button"
              class="btn btn--outline btn--sm"
              data-action="click->book-form#fetchSingleField"
              data-field="author">
        補完
      </button>
    </div>
  </div>

  <%# 翻訳者 %>
  <div class="form-field">
    <%= f.label :translator, '翻訳者', class: 'form-field__label' %>
    <span class="form-field__optional">任意</span>
    <div class="form-field__input-row">
      <%= f.text_field :translator,
            class: 'form-field__input',
            placeholder: '例: 角征典 (複数いる場合はカンマ区切り)',
            autocomplete: 'off' %>
      <button type="button"
              class="btn btn--outline btn--sm"
              data-action="click->book-form#fetchSingleField"
              data-field="translator">
        補完
      </button>
    </div>
  </div>

  <%# ジャンル %>
  <div class="form-field">
    <%= f.label :genre, 'ジャンル', class: 'form-field__label' %>
    <span class="form-field__optional">任意</span>
    <div class="form-field__input-row">
      <%= f.text_field :genre,
            class: "form-field__input #{'form-field__input--error' if book.errors[:genre].any?}",
            placeholder: '例: プログラミング',
            autocomplete: 'off' %>
      <button type="button"
              class="btn btn--outline btn--sm"
              data-action="click->book-form#fetchSingleField"
              data-field="genre">
        補完
      </button>
    </div>
    <% if book.errors[:genre].any? %>
      <span class="form-field__error"><%= book.errors[:genre].first %></span>
    <% end %>
  </div>

  <%# 出版社 %>
  <div class="form-field">
    <%= f.label :publisher, '出版社', class: 'form-field__label' %>
    <span class="form-field__optional">任意</span>
    <div class="form-field__input-row">
      <%= f.text_field :publisher,
            class: "form-field__input #{'form-field__input--error' if book.errors[:publisher].any?}",
            placeholder: '例: オライリー・ジャパン',
            autocomplete: 'off' %>
      <button type="button"
              class="btn btn--outline btn--sm"
              data-action="click->book-form#fetchSingleField"
              data-field="publisher">
        補完
      </button>
    </div>
    <% if book.errors[:publisher].any? %>
      <span class="form-field__error"><%= book.errors[:publisher].first %></span>
    <% end %>
  </div>

  <%# 書影アップロード %>
  <div class="form-field">
    <%= f.label :cover_image, '書影画像', class: 'form-field__label' %>
    <span class="form-field__optional">任意</span>
    <% if book.cover_image.attached? %>
      <div class="form-field__current-cover">
        <%= image_tag url_for(book.cover_image),
              alt: "現在の書影",
              class: "form-field__cover-preview",
              width: 80 %>
        <span class="form-field__hint">現在の書影。変更する場合は新しい画像を選択してください。</span>
      </div>
    <% end %>
    <div class="form-field__input-row">
      <%= f.file_field :cover_image,
            class: "form-field__file #{'form-field__input--error' if book.errors[:cover_image].any?}",
            accept: 'image/jpeg,image/png,image/webp',
            data: { action: 'change->book-form#clearCoverImageUrl' } %>
      <button type="button"
              class="btn btn--outline btn--sm"
              data-action="click->book-form#fetchSingleField"
              data-field="cover">
        補完
      </button>
    </div>
    <small class="form-field__hint">JPEG・PNG・WebP形式、5MB以内。情報取得で見つかった書影は未設定時のみ自動設定されます。</small>
    <% if book.errors[:cover_image].any? %>
      <span class="form-field__error"><%= book.errors[:cover_image].first %></span>
    <% end %>
  </div>

  <%# ページ数 %>
  <div class="form-field">
    <%= f.label :pages, 'ページ数', class: 'form-field__label' %>
    <span class="form-field__required" aria-hidden="true">必須</span>
    <div class="form-field__input-row">
      <%= f.number_field :pages,
            class: "form-field__input form-field__input--narrow #{'form-field__input--error' if book.errors[:pages].any?}",
            min: 1,
            placeholder: '例: 260',
            data: {
              'book-form-target': 'pages',
              action: 'input->book-form#calculateQuota'
            } %>
      <span class="form-field__unit">ページ</span>
      <button type="button"
              class="btn btn--outline btn--sm"
              data-action="click->book-form#fetchSingleField"
              data-field="pages">
        補完
      </button>
    </div>
    <% if book.errors[:pages].any? %>
      <span class="form-field__error"><%= book.errors[:pages].first %></span>
    <% end %>
  </div>

  <%# 読了期限 %>
  <%# モデルの deadline_optional? と同じ判定: new_record? かつ current_page > 0 の場合も必須表示 %>
  <% past_reading_for_form = ActiveModel::Type::Boolean.new.cast(book.is_past_reading) %>
  <% will_transition_to_reading_on_create = book.new_record? && book.unread? && book.current_page.to_i > 0 %>
  <% deadline_optional_for_form = past_reading_for_form || (book.unread? && !will_transition_to_reading_on_create) || book.completed? %>
  <div class="form-field">
    <%= f.label :deadline, '読了期限', class: 'form-field__label' %>
    <% if deadline_optional_for_form %>
      <span class="form-field__optional">任意</span>
    <% else %>
      <span class="form-field__required" aria-hidden="true">必須</span>
    <% end %>
    <%= f.date_field :deadline,
          class: "form-field__input form-field__input--date #{'form-field__input--error' if book.errors[:deadline].any?}",
          min: (book.completed? ? nil : Date.current.to_s),
          data: {
            'book-form-target': 'deadline',
            action: 'change->book-form#calculateQuota'
          } %>
    <% if book.errors[:deadline].any? %>
      <span class="form-field__error"><%= book.errors[:deadline].first %></span>
    <% end %>
  </div>

  <%# 既に読んだページ数 %>
  <div class="form-field">
    <%= f.label :current_page, '既に読んだページ数', class: 'form-field__label' %>
    <span class="form-field__optional">任意</span>
    <% current_page_value = if book.new_record? && book.current_page.to_i.zero?
                              nil
                            else
                              book.current_page
                            end %>
    <%= f.number_field :current_page,
          value: current_page_value,
          class: "form-field__input form-field__input--narrow #{'form-field__input--error' if book.errors[:current_page].any?}",
          min: 0,
          placeholder: '未入力なら0として登録されます',
          data: {
            'book-form-target': 'currentPage',
            action: 'input->book-form#calculateQuota'
          } %>
    <span class="form-field__unit">ページ</span>
    <% if book.errors[:current_page].any? %>
      <span class="form-field__error"><%= book.errors[:current_page].first %></span>
    <% end %>
  </div>

  <%# 過去に読んだ本として登録 %>
  <% if book.new_record? %>
  <% show_completed_at_field = ActiveModel::Type::Boolean.new.cast(book.is_past_reading) || book.errors[:completed_at_input].any? %>
  <div class="form-field">
    <label class="form-field__label form-field__label--checkbox">
      <%= f.check_box :is_past_reading, { id: 'book_is_past_reading', data: { action: 'change->book-form#toggleCompletedAtField' } }, 'true', 'false' %>
      <span>過去に読んだ本として登録</span>
    </label>
    <small class="form-field__hint">すでに読了済みの本を登録する場合はチェックしてください</small>
  </div>

  <%# 読了日 %>
  <div class="form-field" id="completed_at_field" <%= 'hidden' unless show_completed_at_field %>>
    <%= f.label :completed_at_input, '読了日', class: 'form-field__label' %>
    <span class="form-field__optional">任意</span>
    <%= f.date_field :completed_at_input,
          class: "form-field__input form-field__input--date #{'form-field__input--error' if book.errors[:completed_at_input].any?}",
          max: Date.current.to_s,
          placeholder: '未入力の場合は本日が設定されます' %>
    <small class="form-field__hint">本を読了した日付を入力してください（未来の日付は設定できません）</small>
    <% if book.errors[:completed_at_input].any? %>
      <span class="form-field__error"><%= book.errors[:completed_at_input].first %></span>
    <% end %>
  </div>
  <% end %>

  <%# 書影URL（hidden）%>
  <%= f.hidden_field :cover_image_url %>
  <%# ISBN（hidden）%>
  <%= f.hidden_field :isbn %>

  <%# ノルマプレビュー %>
  <div class="quota-preview" data-book-form-target="quotaDisplay">
    <p class="quota-preview__label">今日のノルマ（目安）</p>
    <p class="quota-preview__value">
      <span class="quota-preview__number">-</span>
      <span class="quota-preview__unit">ページ / 日</span>
    </p>
    <p class="quota-preview__note">読了期限・ページ数を入力すると自動計算されます</p>
  </div>

  <%# ボタン %>
  <div class="form-actions">
    <%= f.submit book.new_record? ? '登録する' : '更新する',
          class: 'btn btn--primary btn--lg' %>
    <%= link_to '一覧に戻る', books_path, class: 'btn btn--outline' %>
  </div>
<% end %>
