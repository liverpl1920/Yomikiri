<% content_for :title, "積読一覧 | Yomikiri" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
  <script>
    window.addEventListener('pageshow', function (event) {
      if (event.persisted) window.location.reload()
    })
  </script>
<% end %>

<section class="books-index" data-controller="search-toggle" data-search-toggle-active-value="<%= @search_active ? 'true' : 'false' %>">
  <div class="container">
    <div class="books-index__header">
      <h1 class="books-index__title">積読一覧</h1>
      <div class="books-index__header-actions">
        <button type="button"
                class="btn btn--secondary books-index__search-toggle-btn"
                data-action="click->search-toggle#toggle"
                data-search-toggle-target="button"
                aria-expanded="false"
                aria-controls="books-search-form">
          検索
        </button>
        <%= link_to "+ 本を追加する", new_book_path, class: "btn btn--primary books-index__add-btn" %>
      </div>
    </div>

    <%= form_with url: books_path, method: :get, local: true,
                  id: "books-search-form",
                  class: "books-index__search",
                  data: { "search-toggle-target": "form" },
                  aria: { hidden: "true" } do %>
      <div class="books-index__search-fields">
        <div class="books-index__search-field">
          <%= label_tag :title, "書籍名", class: "books-index__search-label" %>
          <%= text_field_tag :title, @search_params[:title], class: "books-index__search-input", placeholder: "例: リーダブルコード" %>
        </div>

        <div class="books-index__search-field">
          <%= label_tag :author, "著者名", class: "books-index__search-label" %>
          <div class="search-filter-autocomplete"
               data-controller="search-filter-autocomplete"
               data-search-filter-autocomplete-field-value="author">
            <%= text_field_tag :author, @search_params[:author],
                  class: "books-index__search-input",
                  placeholder: "例: Dustin",
                  autocomplete: "off",
                  data: {
                    "search-filter-autocomplete-target": "input",
                    action: "input->search-filter-autocomplete#onInput keydown->search-filter-autocomplete#onKeydown"
                  } %>
            <ul class="search-filter-autocomplete__list search-filter-autocomplete__list--hidden"
                role="listbox"
                aria-expanded="false"
                data-search-filter-autocomplete-target="list"></ul>
          </div>
        </div>

        <div class="books-index__search-field">
          <%= label_tag :genre, "ジャンル", class: "books-index__search-label" %>
          <div class="search-filter-autocomplete"
               data-controller="search-filter-autocomplete"
               data-search-filter-autocomplete-field-value="genre">
            <%= text_field_tag :genre, @search_params[:genre],
                  class: "books-index__search-input",
                  placeholder: "例: プログラミング",
                  autocomplete: "off",
                  data: {
                    "search-filter-autocomplete-target": "input",
                    action: "input->search-filter-autocomplete#onInput keydown->search-filter-autocomplete#onKeydown"
                  } %>
            <ul class="search-filter-autocomplete__list search-filter-autocomplete__list--hidden"
                role="listbox"
                aria-expanded="false"
                data-search-filter-autocomplete-target="list"></ul>
          </div>
        </div>

        <div class="books-index__search-field">
          <%= label_tag :publisher, "出版社", class: "books-index__search-label" %>
          <div class="search-filter-autocomplete"
               data-controller="search-filter-autocomplete"
               data-search-filter-autocomplete-field-value="publisher">
            <%= text_field_tag :publisher, @search_params[:publisher],
                  class: "books-index__search-input",
                  placeholder: "例: オライリー",
                  autocomplete: "off",
                  data: {
                    "search-filter-autocomplete-target": "input",
                    action: "input->search-filter-autocomplete#onInput keydown->search-filter-autocomplete#onKeydown"
                  } %>
            <ul class="search-filter-autocomplete__list search-filter-autocomplete__list--hidden"
                role="listbox"
                aria-expanded="false"
                data-search-filter-autocomplete-target="list"></ul>
          </div>
        </div>

        <div class="books-index__search-field">
          <%= label_tag :translator, "翻訳者", class: "books-index__search-label" %>
          <div class="search-filter-autocomplete"
               data-controller="search-filter-autocomplete"
               data-search-filter-autocomplete-field-value="translator">
            <%= text_field_tag :translator, @search_params[:translator],
                  class: "books-index__search-input",
                  placeholder: "例: 訳者名",
                  autocomplete: "off",
                  data: {
                    "search-filter-autocomplete-target": "input",
                    action: "input->search-filter-autocomplete#onInput keydown->search-filter-autocomplete#onKeydown"
                  } %>
            <ul class="search-filter-autocomplete__list search-filter-autocomplete__list--hidden"
                role="listbox"
                aria-expanded="false"
                data-search-filter-autocomplete-target="list"></ul>
          </div>
        </div>

        <div class="books-index__search-field">
          <%= label_tag :completed_from, "読了日(開始)", class: "books-index__search-label" %>
          <%= date_field_tag :completed_from, @search_params[:completed_from], class: "books-index__search-input" %>
        </div>

        <div class="books-index__search-field">
          <%= label_tag :completed_to, "読了日(終了)", class: "books-index__search-label" %>
          <%= date_field_tag :completed_to, @search_params[:completed_to], class: "books-index__search-input" %>
        </div>
      </div>

      <div class="books-index__search-actions">
        <%= submit_tag "検索", class: "btn btn--primary" %>
        <%= link_to "クリア", books_path, class: "btn btn--secondary" %>
      </div>
    <% end %>

    <%# メモ検索フォーム %>
    <%= form_with url: books_path, method: :get, local: true,
                  id: "memo-search-form",
                  class: "books-index__memo-search" do %>
      <div class="books-index__memo-search-fields">
        <label for="memo_keyword" class="books-index__search-label">メモ検索</label>
        <%= text_field_tag :memo_keyword, @memo_keyword,
              id: "memo_keyword",
              class: "books-index__search-input books-index__memo-search-input",
              placeholder: "メモ内容のキーワードで検索" %>
        <%= submit_tag "メモを検索", class: "btn btn--secondary",
              id: "memo-search-submit" %>
        <% if @memo_search_active %>
          <%= link_to "クリア", books_path, class: "btn btn--ghost",
                id: "memo-search-clear" %>
        <% end %>
      </div>
    <% end %>

    <% if @memo_search_active %>
      <%= render 'memo_search_results', memos: @memos, memo_keyword: @memo_keyword %>
    <% elsif @books.empty? %>
      <%# Empty State %>
      <div class="books-empty">
        <div class="books-empty__icon" aria-hidden="true">📚</div>
        <% if @search_active %>
          <h2 class="books-empty__title">条件に一致する本がありません</h2>
          <p class="books-empty__description">
            検索条件を変更するか、クリアして再度お試しください。
          </p>
          <%= link_to "検索条件をクリア", books_path, class: "btn btn--secondary btn--lg" %>
        <% else %>
          <h2 class="books-empty__title">積読本はまだありません</h2>
          <p class="books-empty__description">
            最初の本を登録して、読書管理を始めましょう。
          </p>
          <%= link_to "最初の本を登録して始める", new_book_path, class: "btn btn--primary btn--lg" %>
        <% end %>
      </div>
    <% elsif !@memo_search_active %>
      <ul class="book-list" aria-label="積読一覧">
        <% @books.each do |book| %>
        <li class="book-list__item">
            <%= link_to book_path(book), class: "book-card#{' book-card--completed' if book.completed?}" do %>
              <%# 書影 %>
              <div class="book-card__cover-wrapper">
                <div class="book-card__cover <%= book.deadline_urgency_class %>">
                  <% cover_src = book_cover_src(book) %>
                  <% if cover_src %>
                    <img src="<%= cover_src %>"
                         alt="<%= book.title %>の書影"
                         class="book-card__cover-image"
                         loading="lazy"
                         onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='inline-flex';">
                    <span class="book-card__cover-placeholder" aria-hidden="true" style="display: none;">📖</span>
                  <% else %>
                    <span class="book-card__cover-placeholder" aria-hidden="true">📖</span>
                  <% end %>
                </div>
                <% if book.deadline_urgency_class.present? %>
                  <span class="book-card__urgency-badge">
                    <% if book.days_remaining <= 1 %>
                      期限間近！
                    <% elsif book.days_remaining <= 3 %>
                      あと<%= book.days_remaining %>日
                    <% else %>
                      あと<%= book.days_remaining %>日
                    <% end %>
                  </span>
                <% end %>
              </div>

              <%# カード本文 %>
              <div class="book-card__body">
                <h2 class="book-card__title"><%= book.title %></h2>

                <% if book.author.present? %>
                  <p class="book-card__author"><%= book.author %></p>
                <% end %>

                <% if book.genre.present? %>
                  <span class="book-card__genre"><%= book.genre %></span>
                <% end %>

                <%# ステータスバッジ %>
                <span class="book-card__status book-card__status--<%= book.status %>">
                  <%= t("book.status.#{book.status}") %>
                </span>

                <% if book.completed? && book.rating.present? %>
                  <div class="book-card__rating" aria-label="評価 <%= book.rating %> 点">
                    <span class="book-card__rating-label">評価</span>
                    <span class="book-card__rating-stars" aria-hidden="true"><%= '★' * book.rating %></span>
                  </div>
                <% end %>

                <%# 読了日 or 読了期限 %>
                <div class="book-card__deadline">
                  <% if book.completed? %>
                    <span class="book-card__deadline-label">読了日</span>
                    <span class="book-card__deadline-value">
                      <% if book.completed_at.present? %>
                        <%= l(book.completed_at.to_date, format: :long) %>
                      <% else %>
                        未設定
                      <% end %>
                    </span>
                  <% else %>
                    <span class="book-card__deadline-label">読了期限</span>
                    <span class="book-card__deadline-value">
                      <% if book.deadline.present? %>
                        <%= l(book.deadline, format: :long) %>
                      <% else %>
                        未設定
                      <% end %>
                    </span>
                  <% end %>
                </div>

                <%# 進捗バー %>
                <div class="book-card__progress">
                  <div class="book-card__progress-bar-wrapper" role="progressbar"
                       aria-valuenow="<%= book.progress_percentage %>"
                       aria-valuemin="0" aria-valuemax="100"
                       aria-label="進捗 <%= book.progress_percentage %>%">
                    <div class="book-card__progress-bar"
                         style="width: <%= book.progress_percentage %>%;"></div>
                  </div>
                  <span class="book-card__progress-text">
                    <%= book.current_page %> / <%= book.pages %> ページ
                    （<%= book.progress_percentage %>%）
                  </span>
                </div>

                <%# 今日のノルマ %>
                <% unless book.completed? %>
                  <div class="book-card__quota">
                    <span class="book-card__quota-label">今日のノルマ</span>
                    <% if book.overdue? %>
                      <span class="book-card__quota-value book-card__quota-value--overdue">期限超過</span>
                    <% else %>
                      <span class="book-card__quota-value">
                        <strong><%= book.daily_quota %></strong> ページ
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</section>
