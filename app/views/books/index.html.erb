<% content_for :title, "積読一覧 | Yomikiri" %>

<section class="books-index">
  <div class="container">
    <div class="books-index__header">
      <h1 class="books-index__title">積読一覧</h1>
      <%= link_to "+ 本を追加する", new_book_path, class: "btn btn--primary books-index__add-btn" %>
    </div>

    <%= form_with url: books_path, method: :get, local: true, class: "books-index__search" do %>
      <div class="books-index__search-fields">
        <div class="books-index__search-field">
          <%= label_tag :title, "書籍名", class: "books-index__search-label" %>
          <%= text_field_tag :title, @search_params[:title], class: "books-index__search-input", placeholder: "例: リーダブルコード" %>
        </div>

        <div class="books-index__search-field">
          <%= label_tag :author, "著者名", class: "books-index__search-label" %>
          <%= text_field_tag :author, @search_params[:author], class: "books-index__search-input", placeholder: "例: Dustin" %>
        </div>

        <div class="books-index__search-field">
          <%= label_tag :genre, "ジャンル", class: "books-index__search-label" %>
          <%= text_field_tag :genre, @search_params[:genre], class: "books-index__search-input", placeholder: "例: プログラミング" %>
        </div>

        <div class="books-index__search-field">
          <%= label_tag :completed_from, "読了日(開始)", class: "books-index__search-label" %>
          <%= date_field_tag :completed_from, @search_params[:completed_from], class: "books-index__search-input" %>
        </div>

        <div class="books-index__search-field">
          <%= label_tag :completed_to, "読了日(終了)", class: "books-index__search-label" %>
          <%= date_field_tag :completed_to, @search_params[:completed_to], class: "books-index__search-input" %>
        </div>
      </div>

      <div class="books-index__search-actions">
        <%= submit_tag "検索", class: "btn btn--primary" %>
        <%= link_to "クリア", books_path, class: "btn btn--secondary" %>
      </div>
    <% end %>

    <% if @books.empty? %>
      <%# Empty State %>
      <div class="books-empty">
        <div class="books-empty__icon" aria-hidden="true">📚</div>
        <% if @search_active %>
          <h2 class="books-empty__title">条件に一致する本がありません</h2>
          <p class="books-empty__description">
            検索条件を変更するか、クリアして再度お試しください。
          </p>
          <%= link_to "検索条件をクリア", books_path, class: "btn btn--secondary btn--lg" %>
        <% else %>
          <h2 class="books-empty__title">積読本はまだありません</h2>
          <p class="books-empty__description">
            最初の本を登録して、読書管理を始めましょう。
          </p>
          <%= link_to "最初の本を登録して始める", new_book_path, class: "btn btn--primary btn--lg" %>
        <% end %>
      </div>
    <% else %>
      <ul class="book-list" aria-label="積読一覧">
        <% @books.each do |book| %>
        <li class="book-list__item">
            <%= link_to book_path(book), class: "book-card#{' book-card--completed' if book.completed?}" do %>
              <%# 書影 %>
              <div class="book-card__cover-wrapper">
                <div class="book-card__cover <%= book.deadline_urgency_class %>">
                  <% cover_src = book_cover_src(book.cover_image_url) %>
                  <% if cover_src %>
                    <img src="<%= cover_src %>"
                         alt="<%= book.title %>の書影"
                         class="book-card__cover-image"
                         loading="lazy">
                  <% else %>
                    <span class="book-card__cover-placeholder" aria-hidden="true">📖</span>
                  <% end %>
                </div>
                <% if book.deadline_urgency_class.present? %>
                  <span class="book-card__urgency-badge">
                    <% if book.days_remaining <= 1 %>
                      期限間近！
                    <% elsif book.days_remaining <= 3 %>
                      あと<%= book.days_remaining %>日
                    <% else %>
                      あと<%= book.days_remaining %>日
                    <% end %>
                  </span>
                <% end %>
              </div>

              <%# カード本文 %>
              <div class="book-card__body">
                <h2 class="book-card__title"><%= book.title %></h2>

                <% if book.author.present? %>
                  <p class="book-card__author"><%= book.author %></p>
                <% end %>

                <%# ステータスバッジ %>
                <span class="book-card__status book-card__status--<%= book.status %>">
                  <%= t("book.status.#{book.status}") %>
                </span>

                <%# 読了期限 %>
                <div class="book-card__deadline">
                  <span class="book-card__deadline-label">読了期限</span>
                  <span class="book-card__deadline-value"><%= l(book.deadline, format: :long) %></span>
                </div>

                <%# 進捗バー %>
                <div class="book-card__progress">
                  <div class="book-card__progress-bar-wrapper" role="progressbar"
                       aria-valuenow="<%= book.progress_percentage %>"
                       aria-valuemin="0" aria-valuemax="100"
                       aria-label="進捗 <%= book.progress_percentage %>%">
                    <div class="book-card__progress-bar"
                         style="width: <%= book.progress_percentage %>%;"></div>
                  </div>
                  <span class="book-card__progress-text">
                    <%= book.current_page %> / <%= book.target_pages %> ページ
                    （<%= book.progress_percentage %>%）
                  </span>
                </div>

                <%# 今日のノルマ %>
                <% unless book.completed? %>
                  <div class="book-card__quota">
                    <span class="book-card__quota-label">今日のノルマ</span>
                    <% if book.overdue? %>
                      <span class="book-card__quota-value book-card__quota-value--overdue">期限超過</span>
                    <% else %>
                      <span class="book-card__quota-value">
                        <strong><%= book.daily_quota %></strong> ページ
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</section>
