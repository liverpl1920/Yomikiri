<% content_for :title, "#{@book.display_title} | Yomikiri" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="container" data-controller="modal">
  <div class="book-show">
    <%# 書影エリア（賞味期限ビジュアライザー） %>
    <div class="book-show__cover-wrapper" data-controller="image-modal">
      <div class="book-show__cover <%= @book.deadline_urgency_class %>">
        <% cover_src = book_cover_src(@book) %>
        <% if cover_src %>
          <img src="<%= cover_src %>"
               alt="<%= @book.title %>の書影"
               class="book-show__cover-image"
               loading="lazy"
               data-action="click->image-modal#open"
               onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='inline-flex';">
          <span class="book-show__cover-placeholder" aria-hidden="true" style="display: none;">📖</span>
        <% else %>
          <span class="book-show__cover-placeholder" aria-hidden="true">📖</span>
        <% end %>
      </div>
      <% if @book.deadline_urgency_class.present? %>
        <span class="book-show__urgency-badge">
          <% if @book.days_remaining <= 1 %>
            期限間近！
          <% else %>
            あと<%= @book.days_remaining %>日
          <% end %>
        </span>
      <% end %>

      <%# 画像拡大モーダル (Issue #336) %>
      <% if cover_src %>
        <dialog data-image-modal-target="dialog" class="image-modal-dialog" data-action="click->image-modal#closeOnBackdrop">
          <div class="image-modal-dialog__container">
            <img src="<%= cover_src %>" alt="<%= @book.title %>の書影（拡大）" class="image-modal-dialog__image">
            <button type="button" class="image-modal-dialog__close" data-action="click->image-modal#close" aria-label="閉じる">✕</button>
          </div>
        </dialog>
      <% end %>
    </div>

    <div class="book-show__header">
      <h1 class="book-show__title"><%= @book.display_title %></h1>
      <% if @book.previous_book %>
        <p class="book-show__previous-link" style="margin-top: 0.5rem; margin-bottom: 0.5rem; font-size: 0.9rem;">
          <%= link_to "前回（#{@book.reading_round - 1}回目）の読書記録はこちら", book_path(@book.previous_book), style: "color: #3b82f6; text-decoration: underline;" %>
        </p>
      <% end %>
      <% if @book.author.present? %>
        <p class="book-show__author"><%= @book.author %></p>
      <% end %>
      <% if @book.translator.present? %>
        <p class="book-show__translator">翻訳: <%= @book.translator %></p>
      <% end %>
      <span class="book-show__status book-show__status--<%= @book.status %>">
        <%= t("book.status.#{@book.status}") %>
      </span>
    </div>
    
    <% if @book.completed? && (@book.rating.present? || @book.review.present?) %>
      <section class="book-show__review-section" aria-label="書籍の評価と感想">
        <div class="book-show__review-header">
          <h2 class="book-show__review-title">あなたの評価・感想</h2>
          <% if @book.rating.present? && @book.rating.to_i.between?(1, 5) %>
            <div class="book-show__rating-stars" aria-label="評価: <%= @book.rating %> / 5">
              <%= "★" * @book.rating.to_i %><%= "☆" * (5 - @book.rating.to_i) %>
            </div>
          <% end %>
        </div>
        <% if @book.review.present? %>
          <div class="book-show__review-body"><%= simple_format(@book.review) %></div>
        <% end %>
      </section>
    <% end %>

    <div class="book-show__progress">
      <div class="book-show__progress-header">
        <span class="book-show__progress-label">進捗</span>
        <span class="book-show__progress-text">
          <%= @book.current_page %> / <%= @book.pages %> ページ（<%= @book.progress_percentage %>%）
        </span>
      </div>
      <div class="book-show__progress-bar-wrapper" role="progressbar"
           aria-valuenow="<%= @book.progress_percentage %>"
           aria-valuemin="0" aria-valuemax="100"
           aria-label="進捗 <%= @book.progress_percentage %>%">
        <div class="book-show__progress-bar" style="width: <%= @book.progress_percentage %>%;"></div>
      </div>
    </div>

    <% remaining_pages = @book.pages - @book.current_page %>
    <%# 積読かつ読了期限未設定の場合は案内を表示 %>
    <% if @book.unread? && @book.deadline.nil? %>
      <div class="book-show__deadline-notice" role="alert">
        <p>読み始めるには読了期限を設定してください。</p>
        <%= link_to '書籍情報を編集する', edit_book_path(@book), class: 'btn btn--secondary btn--sm' %>
      </div>
    <% end %>
    <% if !@book.completed? && remaining_pages > 0 && !(@book.unread? && @book.deadline.nil?) %>
      <%# 進捗更新フォーム %>
      <div class="book-show__progress-update">

        <%# バリデーションエラー表示 %>
        <% if @book.errors.any? %>
          <div class="form-errors" role="alert">
            <ul class="form-errors__list">
              <% @book.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <h2 class="book-show__progress-update-title">今日の進捗を記録する</h2>

        <%# 現在ページを直接入力 %>
        <%= form_with url: update_progress_book_path(@book), method: :patch,
              data: { turbo: false } do |f| %>
          <div class="progress-update__field">
            <label class="progress-update__label" for="direct_page">現在ページ</label>
            <div class="progress-update__input-row">
              <input type="number" id="direct_page" name="direct_page"
                     class="progress-update__input"
                     value="<%= @book.current_page %>" min="0"
                     max="<%= @book.pages %>"
                     aria-label="現在ページ">
              <span class="progress-update__unit">/ <%= @book.pages %> ページ</span>
            </div>
          </div>
          <%= f.submit "更新する", class: "btn btn--primary" %>
        <% end %>
      </div>
    <% end %>

    <%# 読了ボタン (W-6) %>
    <% unless @book.completed? || (@book.unread? && @book.deadline.nil?) %>
      <% complete_btn_class = @book.progress_percentage >= 100 ? 'book-show__complete-btn book-show__complete-btn--highlighted' : 'book-show__complete-btn' %>
      <div class="book-show__complete-section">
        <%= button_to '読了にする！', complete_book_path(@book),
              method: :patch,
              class: complete_btn_class,
              form: { data: { turbo: false } } %>
      </div>
    <% end %>


    <section class="book-show__chart" aria-label="読書進捗グラフ">
      <div class="book-show__chart-header">
        <h2 class="book-show__chart-title">読書進捗グラフ</h2>
         <p class="book-show__chart-note">記録がない日は前日の累積ページ数を引き継いで表示します。</p>
      </div>
      <p class="book-show__chart-axes">横軸: 日付 / 縦軸: 累積ページ数</p>

      <% if @progress_chart_data.any? { |row| row[:pages_read].positive? } %>
        <% chart_rows = @progress_chart_data %>
        <% max_pages = [@progress_chart_max_pages, 1].max %>
        <% chart_width = [chart_rows.size * 28, 520].max %>
        <% chart_height = 220 %>
        <% chart_padding = { left: 48, right: 20, top: 16, bottom: 30 } %>
        <% plot_width = chart_width - chart_padding[:left] - chart_padding[:right] %>
        <% plot_height = chart_height - chart_padding[:top] - chart_padding[:bottom] %>
        <% y_ticks = [0, (max_pages / 2.0).ceil, max_pages].uniq.sort.reverse %>
        <% x_label_indexes = [0, chart_rows.size / 2, chart_rows.size - 1].uniq %>
        <% x_positions = chart_rows.each_index.map do |index|
             if chart_rows.size == 1
               chart_padding[:left] + (plot_width / 2.0)
             else
               chart_padding[:left] + (plot_width * index / (chart_rows.size - 1).to_f)
             end
           end %>

        <% point_strings = chart_rows.each_with_index.map do |row, index|
             x = x_positions[index]
             y = chart_padding[:top] + plot_height - (row[:cumulative_pages].to_f / max_pages * plot_height)
             "#{x.round(2)},#{y.round(2)}"
           end %>

        <div class="book-show__chart-scroll">
          <svg
            class="book-show__chart-svg"
            viewBox="0 0 <%= chart_width %> <%= chart_height %>"
            role="img"
            aria-label="日別読書ページ数の折れ線グラフ">
            <% y_ticks.each do |tick| %>
              <% y = chart_padding[:top] + plot_height - (tick.to_f / max_pages * plot_height) %>
              <line
                x1="<%= chart_padding[:left] %>"
                y1="<%= y.round(2) %>"
                x2="<%= chart_width - chart_padding[:right] %>"
                y2="<%= y.round(2) %>"
                class="book-show__chart-grid" />
              <text x="<%= chart_padding[:left] - 8 %>" y="<%= y.round(2) + 4 %>" class="book-show__chart-y-label"><%= tick %></text>
            <% end %>

            <line
              x1="<%= chart_padding[:left] %>"
              y1="<%= chart_height - chart_padding[:bottom] %>"
              x2="<%= chart_width - chart_padding[:right] %>"
              y2="<%= chart_height - chart_padding[:bottom] %>"
              class="book-show__chart-axis" />

            <polyline
              class="book-show__chart-line"
              points="<%= point_strings.join(' ') %>" />

            <% chart_rows.each_with_index do |row, index| %>
              <% x = x_positions[index] %>
              <% y = chart_padding[:top] + plot_height - (row[:cumulative_pages].to_f / max_pages * plot_height) %>
              <circle
                cx="<%= x.round(2) %>"
                cy="<%= y.round(2) %>"
                r="<%= row[:pages_read].positive? ? 3.2 : 2.2 %>"
                class="book-show__chart-point <%= row[:pages_read].positive? ? 'book-show__chart-point--active' : 'book-show__chart-point--zero' %>" />
            <% end %>

            <% x_label_indexes.each do |index| %>
              <% row = chart_rows[index] %>
              <% x = x_positions[index] %>
              <text x="<%= x.round(2) %>" y="<%= chart_height - 8 %>" class="book-show__chart-x-label"><%= l(row[:date], format: :short) %></text>
            <% end %>
          </svg>
        </div>

        <div class="book-show__chart-table-wrap" aria-label="日別読書ページ数テーブル">
          <table class="book-show__chart-table">
            <thead>
              <tr>
                <th scope="col">日付</th>
                <th scope="col">累計ページ数</th>
                <th scope="col">当日読了</th>
              </tr>
            </thead>
            <tbody>
              <% chart_rows.each do |row| %>
                <tr data-date="<%= row[:date] %>" data-pages="<%= row[:pages_read] %>" data-cumulative="<%= row[:cumulative_pages] %>">
                  <td><%= l(row[:date], format: :default) %></td>
                  <td><%= row[:cumulative_pages] %> ページ</td>
                  <td><%= row[:pages_read] > 0 ? "+#{row[:pages_read]}" : "-" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="book-show__chart-empty">読書ログがまだありません。進捗を記録するとグラフが表示されます。</p>
      <% end %>
    </section>
    <dl class="book-show__details">
      <div class="book-show__detail-item">
        <dt class="book-show__detail-label">ステータス</dt>
        <dd class="book-show__detail-value">
          <span class="book-card__status book-card__status--<%= @book.status %>">
            <%= t("book.status.#{@book.status}") %>
          </span>
        </dd>
      </div>

      <div class="book-show__detail-item">
        <dt class="book-show__detail-label">種類</dt>
        <dd class="book-show__detail-value">
          <%= @book.category.present? ? I18n.t("book.category.#{@book.category}") : "-" %>
        </dd>
      </div>

      <% if @book.genre.present? %>
        <div class="book-show__detail-item">
          <dt class="book-show__detail-label">ジャンル</dt>
          <dd class="book-show__detail-value"><%= @book.genre %></dd>
        </div>
      <% end %>

      <% if @book.translator.present? %>
        <div class="book-show__detail-item">
          <dt class="book-show__detail-label">翻訳者</dt>
          <dd class="book-show__detail-value"><%= @book.translator %></dd>
        </div>
      <% end %>

      <% if @book.publisher.present? %>
        <div class="book-show__detail-item">
          <dt class="book-show__detail-label">出版社</dt>
          <dd class="book-show__detail-value"><%= @book.publisher %></dd>
        </div>
      <% end %>

      <div class="book-show__detail-item">
        <dt class="book-show__detail-label">読了期限</dt>
        <dd class="book-show__detail-value">
          <% if @book.deadline.present? %>
            <time datetime="<%= @book.deadline %>">
              <%= l(@book.deadline, format: :long) %>
            </time>
          <% else %>
            <span class="book-show__detail-none">未設定</span>
          <% end %>
        </dd>
      </div>

      <div class="book-show__detail-item">
        <dt class="book-show__detail-label">進捗</dt>
        <dd class="book-show__detail-value">
          <div class="book-card__progress">
            <div class="book-card__progress-bar-wrapper" role="progressbar"
                 aria-valuenow="<%= @book.progress_percentage %>"
                 aria-valuemin="0" aria-valuemax="100"
                 aria-label="進捗 <%= @book.progress_percentage %>%">
              <div class="book-card__progress-bar"
                   style="width: <%= @book.progress_percentage %>%;"></div>
            </div>
            <span class="book-card__progress-text">
              <%= @book.current_page %> / <%= @book.pages %> ページ
              （<%= @book.progress_percentage %>%）
            </span>
          </div>
        </dd>
      </div>

      <div class="book-show__detail-item">
        <dt class="book-show__detail-label">残りページ数</dt>
        <dd class="book-show__detail-value"><%= @book.remaining_pages %> ページ</dd>
      </div>

      <div class="book-show__detail-item">
        <dt class="book-show__detail-label">今日のノルマ</dt>
        <dd class="book-show__detail-value">
          <% if @book.completed? %>
            <span class="book-show__quota-done">読了済み</span>
          <% elsif @book.deadline.nil? %>
            <span class="book-show__detail-none">-</span>
          <% elsif @book.overdue? %>
            <span class="book-show__quota-overdue">期限超過</span>
          <% else %>
            <strong><%= @book.daily_quota %></strong> ページ
          <% end %>
        </dd>
      </div>

      <div class="book-show__detail-item">
        <dt class="book-show__detail-label">ページ数</dt>
        <dd class="book-show__detail-value"><%= @book.pages %> ページ</dd>
      </div>

      <div class="book-show__detail-item">
        <dt class="book-show__detail-label">延長回数</dt>
        <dd class="book-show__detail-value"><%= @book.extension_count %> 回</dd>
      </div>
    </dl>

    <section class="book-show__memo" aria-label="コメント・メモ">
      <h2 class="book-show__memo-title">コメント・メモ</h2>

      <%# メモ追加フォーム %>
      <div id="new-book-memo-form">
        <% if @new_book_memo.errors.any? %>
          <div class="form-errors" role="alert">
            <ul class="form-errors__list">
              <% @new_book_memo.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: [@book, @new_book_memo] do |f| %>
          <div class="book-show__memo-field">
            <%= f.label :page_number, '対象ページ（任意）', class: 'book-show__memo-label' %>
            <%= f.text_field :page_number,
                  class: 'book-show__memo-page-input',
                  maxlength: BookMemo::PAGE_NUMBER_MAX_LENGTH,
                  placeholder: '例: 100、100-120、p.200' %>
            <small class="book-show__memo-help">最大20文字</small>
          </div>
          <div class="book-show__memo-field">
            <%= f.text_area :content,
                  class: 'book-show__memo-input',
                  rows: 4,
                  maxlength: BookMemo::CONTENT_MAX_LENGTH,
                  placeholder: '読書中の気づきや記録を追加できます' %>
            <small class="book-show__memo-help">最大2000文字</small>
          </div>
          <div class="book-show__memo-actions">
            <%= f.submit 'メモを追加する', class: 'btn btn--primary' %>
          </div>
        <% end %>
      </div>

      <%# メモタイムライン %>
      <div class="memo-timeline">
        <% if @book_memos.empty? %>
          <p id="memo-timeline-empty" class="memo-timeline__empty">まだメモがありません。読書中の気づきをメモしておきましょう。</p>
          <ul id="memo-timeline-list" class="memo-timeline__list" aria-label="メモの一覧"></ul>
        <% else %>
          <ul id="memo-timeline-list" class="memo-timeline__list" aria-label="メモの一覧">
            <% @book_memos.each do |memo| %>
              <%= render partial: 'book_memos/book_memo', locals: { book_memo: memo, book: @book } %>
            <% end %>
          </ul>
        <% end %>
      </div>
    </section>

    <%# 評価・感想セクション（読了済み時のみ表示）(ISSUE#197) %>
    <% if @book.completed? %>
      <section class="book-show__review" aria-label="評価・感想">
        <h2 class="book-show__review-title">評価・感想</h2>

        <% if @book.errors[:rating].any? || @book.errors[:review].any? %>
          <div class="form-errors" role="alert">
            <ul class="form-errors__list">
              <% (@book.errors[:rating] + @book.errors[:review]).each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @book, url: update_review_book_path(@book), method: :patch, data: { turbo: false } do |f| %>
          <div class="book-show__review-rating">
            <label class="book-show__review-label">評価</label>
            <div class="book-show__stars" role="group" aria-label="評価を選択（1〜5）">
              <% (1..5).reverse_each do |star| %>
                <label class="book-show__star-label">
                  <%= f.radio_button :rating, star,
                        class: 'book-show__star-input',
                        checked: @book.rating == star %>
                  <span class="book-show__star-icon" aria-hidden="true">★</span>
                  <span class="sr-only"><%= star %>点</span>
                </label>
              <% end %>
            </div>
          </div>

          <div class="book-show__review-field">
            <label class="book-show__review-label" for="book_review">感想</label>
            <%= f.text_area :review,
                  id: 'book_review',
                  class: 'book-show__review-input',
                  rows: 4,
                  maxlength: 1000,
                  placeholder: 'この本の感想を書いてみましょう（任意）' %>
            <small class="book-show__review-help">最大1000文字</small>
          </div>

          <div class="book-show__review-actions">
            <%= f.submit '評価・感想を保存する', class: 'btn btn--primary' %>
          </div>
        <% end %>
      </section>
    <% end %>

    <div class="book-show__actions">
      <%= link_to '一覧に戻る', books_path, class: 'btn btn--outline' %>
      <%= link_to 'この本をもう一度読む', new_book_path(copy_from_id: @book.id), class: 'btn btn--secondary' %>
      <%= link_to '書籍情報を編集する', edit_book_path(@book), class: 'btn btn--secondary' %>
      <% unless @book.completed? || @book.deadline.nil? %>
        <button type="button" class="btn btn--secondary"
                data-action="click->modal#openExtend">
          期限を延長する
        </button>
      <% end %>
      <button type="button" class="btn btn--danger"
              data-action="click->modal#open">
        削除する
      </button>
    </div>

    <%# Googleカレンダー連携 (W-7) %>
    <% gcal_title = "【Yomikiri】#{@book.title}" %>
    <% gcal_description = "【Yomikiri】「#{@book.title}」の読書時間" %>
    <div class="book-show__gcal"
         data-controller="google-calendar"
         data-google-calendar-title-value="<%= h(gcal_title) %>"
         data-google-calendar-description-value="<%= h(gcal_description) %>">
      <h2 class="book-show__gcal-title">Googleカレンダーで予定を作る</h2>

      <div class="book-show__gcal-duration">
        <span class="book-show__gcal-label">読書時間を選択</span>
        <div class="book-show__gcal-options"
             data-action="change->google-calendar#updateLink">
          <% [15, 30, 45, 60].each do |min| %>
            <label class="book-show__gcal-option">
              <input type="radio" name="gcal_duration" value="<%= min %>"
                     <%= min == 30 ? 'checked' : '' %>
                     data-google-calendar-target="duration">
              <span><%= min %>分</span>
            </label>
          <% end %>
        </div>
      </div>

      <a class="btn btn--primary book-show__gcal-btn"
         href="#"
         target="_blank"
         rel="noopener noreferrer"
         data-google-calendar-target="link"
         data-action="click->google-calendar#open">
        Googleカレンダーで予定を作る
      </a>

      <p class="book-show__gcal-note">
        ※ MVPでは、Google側での予定の変更・削除はアプリ内に反映されません。
      </p>
    </div>
  </div>

  <%# 削除確認モーダル (W-12) %>
  <div class="modal-overlay"
       hidden
       aria-hidden="true"
       aria-modal="true"
       role="dialog"
       aria-labelledby="modal-title"
       data-modal-target="overlay"
       data-action="click->modal#closeOnBackdrop">
    <div class="modal">
      <h2 class="modal__title" id="modal-title">本の削除</h2>
      <p class="modal__body">
        「<span class="modal__book-name"><%= @book.title %></span>」を削除してもよろしいですか？<br>
        削除すると元に戻すことはできません。
      </p>
      <div class="modal__actions">
        <button type="button" class="btn btn--outline"
                data-action="click->modal#close">
          キャンセル
        </button>
        <%= button_to '削除する', book_path(@book),
              method: :delete,
              class: 'btn btn--danger',
              form: { data: { turbo: false } } %>
      </div>
    </div>
  </div>

  <%# 期限延長モーダル (W-10) %>
  <% if @book.deadline.present? %>
  <div class="modal-overlay"
       hidden
       aria-hidden="true"
       aria-modal="true"
       role="dialog"
       aria-labelledby="extend-modal-title"
       data-modal-target="extendOverlay"
       data-action="click->modal#closeExtendOnBackdrop">
    <div class="modal">
      <h2 class="modal__title" id="extend-modal-title">読了期限の延長</h2>
      <p class="modal__body">
        現在の期限：<time datetime="<%= @book.deadline %>"><%= l(@book.deadline, format: :long) %></time><br>
        延長回数：これまで <%= @book.extension_count %> 回（今回で <%= @book.extension_count + 1 %> 回目）
      </p>

      <%# バリデーションエラー表示（change_deadline で render :show された場合） %>
      <% if @book.errors[:deadline].any? %>
        <div class="form-errors" role="alert">
          <ul class="form-errors__list">
            <% @book.errors[:deadline].each do |message| %>
              <li><%= I18n.t('activerecord.attributes.book.deadline') + message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with url: change_deadline_book_path(@book), method: :patch,
            data: { turbo: false } do |f| %>
        <div class="modal__field">
          <label class="modal__label" for="deadline">新しい期限</label>
          <input type="date" id="deadline" name="deadline"
                 class="modal__input"
                 min="<%= (@book.deadline + 1).to_s %>"
                 value="<%= (@book.deadline + 1).to_s %>"
                 aria-label="新しい読了期限">
        </div>
        <div class="modal__actions">
          <button type="button" class="btn btn--outline"
                  data-action="click->modal#closeExtend">
            キャンセル
          </button>
          <%= f.submit "延長する", class: "btn btn--primary" %>
        </div>
      <% end %>
    </div>
  </div>
  <% end %>

  <%# 読了お祝いモーダル (W-13) %>
  <% if flash[:completed_book].present? %>
    <% days_to_complete = (@book.completed_at.to_date - @book.created_at.to_date).to_i + 1 %>
    <div class="modal-overlay celebration-modal-overlay"
         aria-modal="true"
         role="dialog"
         aria-labelledby="celebration-modal-title">
      <div class="modal celebration-modal">
        <p class="celebration-modal__emoji" aria-hidden="true">🎉</p>
        <h2 class="modal__title celebration-modal__title" id="celebration-modal-title">
          読了おめでとうございます！
        </h2>
        <p class="celebration-modal__book-name">
          「<%= @book.title %>」を読み終えました
        </p>
        <dl class="celebration-modal__stats">
          <div class="celebration-modal__stat">
            <dt class="celebration-modal__stat-label">読了日</dt>
            <dd class="celebration-modal__stat-value">
              <%= l(@book.completed_at.to_date, format: :long) %>
            </dd>
          </div>
          <div class="celebration-modal__stat">
            <dt class="celebration-modal__stat-label">読了までの日数</dt>
            <dd class="celebration-modal__stat-value">
              <strong><%= days_to_complete %></strong> 日
            </dd>
          </div>
        </dl>
        <%= form_with model: @book, url: update_review_book_path(@book), method: :patch, class: 'celebration-modal__review-form', data: { turbo: false } do |f| %>
          <%= hidden_field_tag :redirect_to, 'index' %>
          <div class="celebration-modal__field">
            <label class="celebration-modal__form-label">評価</label>
            <div class="rating-input">
              <% (1..5).reverse_each do |i| %>
                <%= f.radio_button :rating, i, id: "star#{i}", class: 'rating-input__star' %>
                <label for="star<%= i %>" class="rating-input__label">★</label>
              <% end %>
            </div>
          </div>

          <div class="celebration-modal__field">
            <%= f.label :review, '感想', class: 'celebration-modal__form-label' %>
            <%= f.text_area :review, class: 'celebration-modal__review-input', placeholder: '本を読み終えた感想を自由に記載しましょう！', maxlength: 1000 %>
          </div>

          <div class="celebration-modal__form-actions">
            <%= f.submit '評価・感想を保存して一覧に戻る', class: 'btn btn--primary' %>
            <%= link_to '保存せずに一覧に戻る', books_path, class: 'btn btn--outline' %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
