<% content_for :title, "#{@book.title} | Yomikiri" %>

<div class="container" data-controller="modal">
  <div class="book-show">
    <%# 書影エリア（賞味期限ビジュアライザー） %>
    <div class="book-show__cover-wrapper">
      <div class="book-show__cover <%= @book.deadline_urgency_class %>">
        <% cover_src = book_cover_src(@book) %>
        <% if cover_src %>
          <img src="<%= cover_src %>"
               alt="<%= @book.title %>の書影"
               class="book-show__cover-image"
               loading="lazy">
        <% else %>
          <span class="book-show__cover-placeholder" aria-hidden="true">📖</span>
        <% end %>
      </div>
      <% if @book.deadline_urgency_class.present? %>
        <span class="book-show__urgency-badge">
          <% if @book.days_remaining <= 1 %>
            期限間近！
          <% else %>
            あと<%= @book.days_remaining %>日
          <% end %>
        </span>
      <% end %>
    </div>

    <div class="book-show__header">
      <h1 class="book-show__title"><%= @book.title %></h1>
      <% if @book.author.present? %>
        <p class="book-show__author"><%= @book.author %></p>
      <% end %>
      <span class="book-show__status book-show__status--<%= @book.status %>">
        <%= t("book.status.#{@book.status}") %>
      </span>
    </div>

    <div class="book-show__progress">
      <div class="book-show__progress-header">
        <span class="book-show__progress-label">進捗</span>
        <span class="book-show__progress-text">
          <%= @book.current_page %> / <%= @book.target_pages %> ページ（<%= @book.progress_percentage %>%）
        </span>
      </div>
      <div class="book-show__progress-bar-wrapper" role="progressbar"
           aria-valuenow="<%= @book.progress_percentage %>"
           aria-valuemin="0" aria-valuemax="100"
           aria-label="進捗 <%= @book.progress_percentage %>%">
        <div class="book-show__progress-bar" style="width: <%= @book.progress_percentage %>%;"></div>
      </div>
    </div>

    <% remaining_pages = @book.target_pages - @book.current_page %>
    <%# 積読かつ読了期限未設定の場合は案内を表示 %>
    <% if @book.unread? && @book.deadline.nil? %>
      <div class="book-show__deadline-notice" role="alert">
        <p>読み始めるには読了期限を設定してください。</p>
        <%= link_to '書籍情報を編集する', edit_book_path(@book), class: 'btn btn--secondary btn--sm' %>
      </div>
    <% end %>
    <% if !@book.completed? && remaining_pages > 0 && !(@book.unread? && @book.deadline.nil?) %>
      <%# 進捗更新フォーム %>
      <div class="book-show__progress-update"
           data-controller="progress-update"
           data-progress-update-max-value="<%= remaining_pages %>">

        <%# バリデーションエラー表示 %>
        <% if @book.errors.any? %>
          <div class="form-errors" role="alert">
            <ul class="form-errors__list">
              <% @book.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <h2 class="book-show__progress-update-title">今日の進捗を記録する</h2>

        <%# 今日読んだページ数フォーム（デフォルト） %>
        <%= form_with url: update_progress_book_path(@book), method: :patch,
              data: { turbo: false } do |f| %>
          <div class="progress-update__field">
            <label class="progress-update__label" for="pages_read">今日読んだページ数</label>
            <div class="progress-update__input-group">
              <button type="button" class="progress-update__step-btn"
                      aria-label="1ページ減らす"
                      data-action="click->progress-update#decrement">
                −
              </button>
              <input type="number" id="pages_read" name="pages_read"
                     class="progress-update__input"
                     value="1" min="1"
                     max="<%= @book.target_pages - @book.current_page %>"
                     data-progress-update-target="pagesRead"
                     aria-label="今日読んだページ数">
              <button type="button" class="progress-update__step-btn"
                      aria-label="1ページ増やす"
                      data-action="click->progress-update#increment">
                ＋
              </button>
            </div>
          </div>
          <%= f.submit "更新する", class: "btn btn--primary" %>
        <% end %>

        <%# 現在ページを直接入力（折りたたみ） %>
        <div class="progress-update__advanced">
          <button type="button" class="progress-update__toggle"
                  aria-expanded="false"
                  aria-controls="direct-input-section"
                  data-action="click->progress-update#toggleAdvanced">
            <span class="progress-update__toggle-icon" aria-hidden="true">▶</span>
            現在ページを直接入力
          </button>
          <div id="direct-input-section"
               class="progress-update__advanced-section"
               hidden
               data-progress-update-target="advancedSection">
            <%= form_with url: update_progress_book_path(@book), method: :patch,
                  data: { turbo: false } do |f| %>
              <div class="progress-update__field">
                <label class="progress-update__label" for="direct_page">現在ページ</label>
                <div class="progress-update__input-row">
                  <input type="number" id="direct_page" name="direct_page"
                         class="progress-update__input"
                         value="<%= @book.current_page %>" min="0"
                         max="<%= @book.target_pages %>"
                         aria-label="現在ページ">
                  <span class="progress-update__unit">/ <%= @book.target_pages %> ページ</span>
                </div>
              </div>
              <%= f.submit "更新する", class: "btn btn--primary" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# 読了ボタン (W-6) %>
    <% unless @book.completed? || (@book.unread? && @book.deadline.nil?) %>
      <% complete_btn_class = @book.progress_percentage >= 100 ? 'book-show__complete-btn book-show__complete-btn--highlighted' : 'book-show__complete-btn' %>
      <div class="book-show__complete-section">
        <%= button_to '読了にする！', complete_book_path(@book),
              method: :patch,
              class: complete_btn_class,
              form: { data: { turbo: false } } %>
      </div>
    <% end %>

    <dl class="book-show__details">
      <div class="book-show__detail-item">
        <dt class="book-show__detail-label">ステータス</dt>
        <dd class="book-show__detail-value">
          <span class="book-card__status book-card__status--<%= @book.status %>">
            <%= t("book.status.#{@book.status}") %>
          </span>
        </dd>
      </div>

      <div class="book-show__detail-item">
        <dt class="book-show__detail-label">読了期限</dt>
        <dd class="book-show__detail-value">
          <% if @book.deadline.present? %>
            <time datetime="<%= @book.deadline %>">
              <%= l(@book.deadline, format: :long) %>
            </time>
          <% else %>
            <span class="book-show__detail-none">未設定</span>
          <% end %>
        </dd>
      </div>

      <div class="book-show__detail-item">
        <dt class="book-show__detail-label">進捗</dt>
        <dd class="book-show__detail-value">
          <div class="book-card__progress">
            <div class="book-card__progress-bar-wrapper" role="progressbar"
                 aria-valuenow="<%= @book.progress_percentage %>"
                 aria-valuemin="0" aria-valuemax="100"
                 aria-label="進捗 <%= @book.progress_percentage %>%">
              <div class="book-card__progress-bar"
                   style="width: <%= @book.progress_percentage %>%;"></div>
            </div>
            <span class="book-card__progress-text">
              <%= @book.current_page %> / <%= @book.target_pages %> ページ
              （<%= @book.progress_percentage %>%）
            </span>
          </div>
        </dd>
      </div>

      <div class="book-show__detail-item">
        <dt class="book-show__detail-label">残りページ数</dt>
        <dd class="book-show__detail-value"><%= @book.remaining_pages %> ページ</dd>
      </div>

      <div class="book-show__detail-item">
        <dt class="book-show__detail-label">今日のノルマ</dt>
        <dd class="book-show__detail-value">
          <% if @book.completed? %>
            <span class="book-show__quota-done">読了済み</span>
          <% elsif @book.deadline.nil? %>
            <span class="book-show__detail-none">-</span>
          <% elsif @book.overdue? %>
            <span class="book-show__quota-overdue">期限超過</span>
          <% else %>
            <strong><%= @book.daily_quota %></strong> ページ
          <% end %>
        </dd>
      </div>

      <div class="book-show__detail-item">
        <dt class="book-show__detail-label">総ページ数</dt>
        <dd class="book-show__detail-value"><%= @book.total_pages %> ページ</dd>
      </div>

      <div class="book-show__detail-item">
        <dt class="book-show__detail-label">延長回数</dt>
        <dd class="book-show__detail-value"><%= @book.extension_count %> 回</dd>
      </div>
    </dl>

    <section class="book-show__memo" aria-label="コメント・メモ">
      <h2 class="book-show__memo-title">コメント・メモ</h2>

      <% if @book.errors[:memo].any? %>
        <div class="form-errors" role="alert">
          <ul class="form-errors__list">
            <% @book.errors[:memo].each do |message| %>
              <li><%= I18n.t('activerecord.attributes.book.memo') + message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @book, url: update_memo_book_path(@book), method: :patch, data: { turbo: false } do |f| %>
        <div class="book-show__memo-field">
          <%= f.text_area :memo,
                value: flash[:memo_saved] ? '' : @book.memo,
                class: 'book-show__memo-input',
                rows: 5,
                maxlength: Book::MEMO_MAX_LENGTH,
                placeholder: '読書中の気づきや次回読むときのメモを入力できます' %>
          <small class="book-show__memo-help">最大2000文字。空欄で保存するとメモをクリアできます。</small>
        </div>
        <div class="book-show__memo-actions">
          <%= f.submit 'メモを保存する', class: 'btn btn--primary' %>
        </div>
      <% end %>

      <% if @book.memo.present? %>
        <div class="book-show__memo-preview">
          <p class="book-show__memo-preview-label">保存済みメモ</p>
          <% if @book.memo_updated_at.present? %>
            <p class="book-show__memo-preview-date"><%= l(@book.memo_updated_at, format: :default) %> 記録</p>
          <% end %>
          <div class="book-show__memo-preview-body"><%= simple_format(@book.memo) %></div>
        </div>
      <% end %>
    </section>

    <%# 評価・感想セクション（読了済み時のみ表示）(ISSUE#197) %>
    <% if @book.completed? %>
      <section class="book-show__review" aria-label="評価・感想">
        <h2 class="book-show__review-title">評価・感想</h2>

        <% if @book.errors[:rating].any? || @book.errors[:review].any? %>
          <div class="form-errors" role="alert">
            <ul class="form-errors__list">
              <% (@book.errors[:rating] + @book.errors[:review]).each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @book, url: update_review_book_path(@book), method: :patch, data: { turbo: false } do |f| %>
          <div class="book-show__review-rating">
            <label class="book-show__review-label">評価</label>
            <div class="book-show__stars" role="group" aria-label="評価を選択（1〜5）">
              <% (1..5).each do |star| %>
                <label class="book-show__star-label">
                  <%= f.radio_button :rating, star,
                        class: 'book-show__star-input',
                        checked: @book.rating == star %>
                  <span class="book-show__star-icon" aria-hidden="true">★</span>
                  <span class="sr-only"><%= star %>点</span>
                </label>
              <% end %>
            </div>
          </div>

          <div class="book-show__review-field">
            <label class="book-show__review-label" for="book_review">感想</label>
            <%= f.text_area :review,
                  id: 'book_review',
                  class: 'book-show__review-input',
                  rows: 4,
                  maxlength: 1000,
                  placeholder: 'この本の感想を書いてみましょう（任意）' %>
            <small class="book-show__review-help">最大1000文字</small>
          </div>

          <div class="book-show__review-actions">
            <%= f.submit '評価・感想を保存する', class: 'btn btn--primary' %>
          </div>
        <% end %>
      </section>
    <% end %>

    <div class="book-show__actions">
      <%= link_to '一覧に戻る', books_path, class: 'btn btn--outline' %>
      <%= link_to '書籍情報を編集する', edit_book_path(@book), class: 'btn btn--secondary' %>
      <% unless @book.completed? || @book.deadline.nil? %>
        <button type="button" class="btn btn--secondary"
                data-action="click->modal#openExtend">
          期限を延長する
        </button>
      <% end %>
      <button type="button" class="btn btn--danger"
              data-action="click->modal#open">
        削除する
      </button>
    </div>

    <%# Googleカレンダー連携 (W-7) %>
    <% gcal_title = "【Yomikiri】#{@book.title}" %>
    <% gcal_description = "【Yomikiri】「#{@book.title}」の読書時間" %>
    <div class="book-show__gcal"
         data-controller="google-calendar"
         data-google-calendar-title-value="<%= h(gcal_title) %>"
         data-google-calendar-description-value="<%= h(gcal_description) %>">
      <h2 class="book-show__gcal-title">Googleカレンダーで予定を作る</h2>

      <div class="book-show__gcal-duration">
        <span class="book-show__gcal-label">読書時間を選択</span>
        <div class="book-show__gcal-options"
             data-action="change->google-calendar#updateLink">
          <% [15, 30, 45, 60].each do |min| %>
            <label class="book-show__gcal-option">
              <input type="radio" name="gcal_duration" value="<%= min %>"
                     <%= min == 30 ? 'checked' : '' %>
                     data-google-calendar-target="duration">
              <span><%= min %>分</span>
            </label>
          <% end %>
        </div>
      </div>

      <a class="btn btn--primary book-show__gcal-btn"
         href="#"
         target="_blank"
         rel="noopener noreferrer"
         data-google-calendar-target="link"
         data-action="click->google-calendar#open">
        Googleカレンダーで予定を作る
      </a>

      <p class="book-show__gcal-note">
        ※ MVPでは、Google側での予定の変更・削除はアプリ内に反映されません。
      </p>
    </div>
  </div>

  <%# 削除確認モーダル (W-12) %>
  <div class="modal-overlay"
       hidden
       aria-hidden="true"
       aria-modal="true"
       role="dialog"
       aria-labelledby="modal-title"
       data-modal-target="overlay"
       data-action="click->modal#closeOnBackdrop">
    <div class="modal">
      <h2 class="modal__title" id="modal-title">本の削除</h2>
      <p class="modal__body">
        「<span class="modal__book-name"><%= @book.title %></span>」を削除してもよろしいですか？<br>
        削除すると元に戻すことはできません。
      </p>
      <div class="modal__actions">
        <button type="button" class="btn btn--outline"
                data-action="click->modal#close">
          キャンセル
        </button>
        <%= button_to '削除する', book_path(@book),
              method: :delete,
              class: 'btn btn--danger',
              form: { data: { turbo: false } } %>
      </div>
    </div>
  </div>

  <%# 期限延長モーダル (W-10) %>
  <% if @book.deadline.present? %>
  <div class="modal-overlay"
       hidden
       aria-hidden="true"
       aria-modal="true"
       role="dialog"
       aria-labelledby="extend-modal-title"
       data-modal-target="extendOverlay"
       data-action="click->modal#closeExtendOnBackdrop">
    <div class="modal">
      <h2 class="modal__title" id="extend-modal-title">読了期限の延長</h2>
      <p class="modal__body">
        現在の期限：<time datetime="<%= @book.deadline %>"><%= l(@book.deadline, format: :long) %></time><br>
        延長回数：これまで <%= @book.extension_count %> 回（今回で <%= @book.extension_count + 1 %> 回目）
      </p>

      <%# バリデーションエラー表示（change_deadline で render :show された場合） %>
      <% if @book.errors[:deadline].any? %>
        <div class="form-errors" role="alert">
          <ul class="form-errors__list">
            <% @book.errors[:deadline].each do |message| %>
              <li><%= I18n.t('activerecord.attributes.book.deadline') + message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with url: change_deadline_book_path(@book), method: :patch,
            data: { turbo: false } do |f| %>
        <div class="modal__field">
          <label class="modal__label" for="deadline">新しい期限</label>
          <input type="date" id="deadline" name="deadline"
                 class="modal__input"
                 min="<%= (@book.deadline + 1).to_s %>"
                 value="<%= (@book.deadline + 1).to_s %>"
                 aria-label="新しい読了期限">
        </div>
        <div class="modal__actions">
          <button type="button" class="btn btn--outline"
                  data-action="click->modal#closeExtend">
            キャンセル
          </button>
          <%= f.submit "延長する", class: "btn btn--primary" %>
        </div>
      <% end %>
    </div>
  </div>
  <% end %>

  <%# 読了お祝いモーダル (W-13) %>
  <% if flash[:completed_book].present? %>
    <% days_to_complete = (@book.completed_at.to_date - @book.created_at.to_date).to_i + 1 %>
    <div class="modal-overlay celebration-modal-overlay"
         aria-modal="true"
         role="dialog"
         aria-labelledby="celebration-modal-title">
      <div class="modal celebration-modal">
        <p class="celebration-modal__emoji" aria-hidden="true">🎉</p>
        <h2 class="modal__title celebration-modal__title" id="celebration-modal-title">
          読了おめでとうございます！
        </h2>
        <p class="celebration-modal__book-name">
          「<%= @book.title %>」を読み終えました
        </p>
        <dl class="celebration-modal__stats">
          <div class="celebration-modal__stat">
            <dt class="celebration-modal__stat-label">読了日</dt>
            <dd class="celebration-modal__stat-value">
              <%= l(@book.completed_at.to_date, format: :long) %>
            </dd>
          </div>
          <div class="celebration-modal__stat">
            <dt class="celebration-modal__stat-label">読了までの日数</dt>
            <dd class="celebration-modal__stat-value">
              <strong><%= days_to_complete %></strong> 日
            </dd>
          </div>
        </dl>
        <div class="modal__actions">
          <%= link_to '一覧に戻る', books_path, class: 'btn btn--primary' %>
        </div>
      </div>
    </div>
  <% end %>
</div>
