<% content_for :title, "マイページ | Yomikiri" %>

<section class="mypage">
  <div class="container">
    <div class="mypage__header">
      <h1 class="mypage__title">マイページ</h1>
      <%= link_to '← 一覧に戻る', books_path, class: 'btn btn--outline mypage__back-btn' %>
    </div>

    <% persisted_nickname = current_user.attribute_in_database(:nickname) %>
    <% persisted_display_name = persisted_nickname.presence || current_user.email %>
    <%# ユーザー情報カード %>
    <div class="mypage__card">
      <h2 class="mypage__card-title">プロフィール</h2>
      <dl class="mypage__info-list">
        <div class="mypage__info-item">
          <dt class="mypage__info-label">ニックネーム</dt>
          <dd class="mypage__info-value"><%= persisted_display_name %></dd>
        </div>
        <div class="mypage__info-item">
          <dt class="mypage__info-label">メールアドレス</dt>
          <dd class="mypage__info-value"><%= current_user.email %></dd>
        </div>
        <div class="mypage__info-item">
          <dt class="mypage__info-label">年間目標</dt>
          <dd class="mypage__info-value"><%= current_user.yearly_goal %> 冊</dd>
        </div>
        <div class="mypage__info-item">
          <dt class="mypage__info-label">登録日</dt>
          <dd class="mypage__info-value"><%= l(current_user.created_at.to_date, format: :long) %></dd>
        </div>
      </dl>

      <%# プロフィール編集フォーム %>
      <div class="mypage__nickname-edit">
        <h3 class="mypage__nickname-edit-title">プロフィールを変更する</h3>
        <%= form_with model: current_user, url: mypage_path, method: :patch, class: 'mypage__form' do |f| %>
          <% if current_user.errors.any? %>
            <div class="mypage__form-errors" role="alert">
              <ul>
                <% current_user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <div class="mypage__form-group">
            <%= f.label :nickname, 'ニックネーム（最大50文字）', class: 'mypage__form-label' %>
            <%= f.text_field :nickname,
                  value: current_user.nickname,
                  placeholder: 'ニックネームを入力（未設定の場合はメールアドレスが表示されます）',
                  maxlength: 50,
                  class: 'mypage__form-input',
                  autocomplete: 'nickname' %>
          </div>
          <div class="mypage__form-group">
            <%= f.label :yearly_goal, '年間目標（目標冊数）', class: 'mypage__form-label' %>
            <%= f.number_field :yearly_goal,
                  value: current_user.yearly_goal,
                  min: 1,
                  class: 'mypage__form-input' %>
          </div>
          <%= f.submit '更新する', class: 'btn btn--primary' %>
        <% end %>
      </div>
    </div>

    <%# ジャンル設定 %>
    <div class="mypage__card" id="genre-settings">
      <h2 class="mypage__card-title">ジャンル設定</h2>
      <p class="mypage__genre-caption">
        よく使うジャンルを登録しておくと、書籍登録・編集時に候補として表示されます（最大50件）。
      </p>

      <%# ジャンル追加フォーム %>
      <div id="genre-add-form-container">
        <%= render "genres/genre_form", genre: Genre.new %>
      </div>

      <%# ジャンル一覧 %>
      <% genres = current_user.genres.order(:name) %>
      <% if genres.empty? %>
        <p class="mypage__genre-empty" id="genre-list-empty">ジャンルはまだ登録されていません。</p>
      <% else %>
        <ul class="genre-list" id="genre-list">
          <%= render genres %>
        </ul>
      <% end %>
    </div>

    <%# アカウント設定 %>
    <div class="mypage__card">
      <h2 class="mypage__card-title">アカウント設定</h2>
      <ul class="mypage__settings-list">
        <li>
          <%= link_to 'パスワードを変更する', edit_user_registration_path, class: 'mypage__settings-link' %>
        </li>
        <li>
          <%= link_to 'メールアドレスを変更する', edit_email_change_path, class: 'mypage__settings-link' %>
        </li>
      </ul>
    </div>

    <%# 読書実績カード %>
    <div class="mypage__card">
      <h2 class="mypage__card-title">読書実績</h2>
      <div class="mypage__stats">
        <div class="mypage__stat-item">
          <span class="mypage__stat-number"><%= current_user.completed_books_count %></span>
          <span class="mypage__stat-label">読了冊数</span>
        </div>
        <div class="mypage__stat-item">
          <span class="mypage__stat-number"><%= current_user.completed_pages_total %></span>
          <span class="mypage__stat-label">総読了ページ数</span>
        </div>
        <div class="mypage__stat-item">
          <div>
            <span class="mypage__stat-number"><%= current_user.consecutive_reading_days %></span><span class="mypage__stat-unit"><%= t('streak.unit', count: current_user.consecutive_reading_days) %></span>
          </div>
          <span class="mypage__stat-label">連続読書日数</span>
        </div>
      </div>
    </div>

    <%# 日別読書ログ %>
    <div class="mypage__card">
      <h2 class="mypage__card-title">日別読書ログ</h2>
      <p class="mypage__daily-log-caption">直近7日間の読書記録を表示しています。</p>
      <ul class="mypage__daily-log-list">
        <% @daily_reading_logs.each do |read_at, logs| %>
          <li class="mypage__daily-log-item">
            <h3 class="mypage__daily-log-date"><%= l(read_at, format: :long) %></h3>
            <% if logs.empty? %>
              <p class="mypage__daily-log-empty">記録なし</p>
            <% else %>
              <ul class="mypage__daily-log-book-list">
                <% logs.each do |log| %>
                  <li class="mypage__daily-log-book-item">
                    <span class="mypage__daily-log-book-title"><%= log.book.title %></span>
                    <span class="mypage__daily-log-pages">+<%= log.pages_read %>ページ</span>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>

    <%# 読了履歴 %>
    <div class="mypage__card">
      <h2 class="mypage__card-title">読了履歴</h2>
      <% if @completed_books.empty? %>
        <p class="mypage__empty-message">読了した本はまだありません。</p>
      <% else %>
        <ul class="mypage__history-list">
          <% @completed_books.each do |book| %>
            <li class="mypage__history-item">
              <%= link_to book_path(book), class: 'mypage__history-link' do %>
                <span class="mypage__history-title"><%= book.title %></span>
                <% if book.author.present? %>
                  <span class="mypage__history-author"><%= book_author_display(book) %></span>
                <% end %>
                <span class="mypage__history-date">
                  読了日: <%= book.completed_at ? l(book.completed_at.to_date, format: :default) : '不明' %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
</section>
