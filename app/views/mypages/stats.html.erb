<% content_for :title, "読書統計 | Yomikiri" %>

<section class="mypage-stats">
  <div class="container">
    <div class="mypage-stats__header">
      <h1 class="mypage-stats__title">読書統計</h1>
      <div class="mypage-stats__header-links">
        <%= link_to '← マイページへ戻る', mypage_path, class: 'btn btn--outline' %>
        <%= link_to '一覧に戻る', books_path, class: 'btn btn--outline' %>
      </div>
    </div>

    <div class="mypage-stats__period-tabs" role="tablist" aria-label="集計期間">
      <%= link_to '週次',
            stats_mypage_path(period: 'weekly'),
            class: ["mypage-stats__period-tab", (@period == 'weekly' ? 'mypage-stats__period-tab--active' : nil)].compact.join(' '),
            role: 'tab',
            aria: { selected: (@period == 'weekly').to_s } %>
      <%= link_to '月次',
            stats_mypage_path(period: 'monthly'),
            class: ["mypage-stats__period-tab", (@period == 'monthly' ? 'mypage-stats__period-tab--active' : nil)].compact.join(' '),
            role: 'tab',
            aria: { selected: (@period == 'monthly').to_s } %>
      <%= link_to 'カスタム期間',
            stats_mypage_path(period: 'custom'),
            class: ["mypage-stats__period-tab", (@period == 'custom' ? 'mypage-stats__period-tab--active' : nil)].compact.join(' '),
            role: 'tab',
            aria: { selected: (@period == 'custom').to_s } %>
    </div>

    <% if @period == 'custom' %>
      <div class="mypage-stats__custom-form">
        <%= form_with url: stats_mypage_path, method: :get, local: true, class: 'mypage-stats__custom-form-inner' do |f| %>
          <%= hidden_field_tag :period, 'custom' %>
          <div class="mypage-stats__custom-form-fields">
            <div class="mypage-stats__custom-form-field">
              <%= label_tag :start_date, '開始日', class: 'mypage-stats__custom-form-label' %>
              <%= date_field_tag :start_date,
                    (@custom_start_date || @summary[:start_date]),
                    class: 'mypage-stats__custom-form-input' %>
            </div>
            <span class="mypage-stats__custom-form-sep">〜</span>
            <div class="mypage-stats__custom-form-field">
              <%= label_tag :end_date, '終了日', class: 'mypage-stats__custom-form-label' %>
              <%= date_field_tag :end_date,
                    (@custom_end_date || @summary[:end_date]),
                    class: 'mypage-stats__custom-form-input' %>
            </div>
            <%= submit_tag '表示', class: 'btn btn--primary' %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mypage-stats__period-summary">
      <p class="mypage-stats__period-label">
        <strong><%= @summary[:period_label] %>集計:</strong>
        <%= l(@summary[:start_date], format: :default) %> 〜 <%= l(@summary[:end_date], format: :default) %>
      </p>
    </div>

    <div class="mypage-stats__cards">
      <article class="mypage-stats__card">
        <h2 class="mypage-stats__card-title">読了ページ数</h2>
        <p class="mypage-stats__card-value"><%= @summary[:total_pages] %></p>
        <p class="mypage-stats__card-unit">ページ</p>
      </article>

      <article class="mypage-stats__card">
        <h2 class="mypage-stats__card-title">読了冊数</h2>
        <p class="mypage-stats__card-value"><%= @completed_books_count %></p>
        <p class="mypage-stats__card-unit">冊</p>
      </article>

      <article class="mypage-stats__card">
        <h2 class="mypage-stats__card-title">平均ページ/日</h2>
        <p class="mypage-stats__card-value"><%= number_with_precision(@average_pages_per_day, precision: 1, strip_insignificant_zeros: true) %></p>
        <p class="mypage-stats__card-unit">ページ/日</p>
      </article>
    </div>

    <section class="mypage-stats__daily">
      <h2 class="mypage-stats__breakdown-title">日別読了ページ数</h2>

      <% if @summary[:daily_pages].values.sum.zero? %>
        <p class="mypage-stats__empty">この期間の読書記録はありません。</p>
      <% else %>
        <div class="mypage-stats__daily-chart" aria-label="日別読了ページ数グラフ">
          <% @summary[:daily_pages].each do |date, pages| %>
            <% ratio = @max_daily_pages.positive? ? ((pages.to_f / @max_daily_pages) * 100).round(1) : 0 %>
            <div class="mypage-stats__daily-row">
              <span class="mypage-stats__daily-date"><%= l(date, format: :short) %></span>
              <div class="mypage-stats__daily-bar-wrap">
                <div class="mypage-stats__daily-bar" style="width: <%= ratio %>%" aria-hidden="true"></div>
              </div>
              <span class="mypage-stats__daily-pages"><%= pages > 0 ? "#{pages}p" : "-" %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="mypage-stats__breakdown">
      <h2 class="mypage-stats__breakdown-title">書籍別の読了ページ内訳</h2>

      <% if @summary[:books].empty? %>
        <p class="mypage-stats__empty">この期間の読書記録はありません。</p>
      <% else %>
        <ul class="mypage-stats__list">
          <% @summary[:books].each do |book_summary| %>
            <% pages_read = book_summary[:pages_read] %>
            <% ratio = @max_pages_read.positive? ? ((pages_read.to_f / @max_pages_read) * 100).round(1) : 0 %>
            <li class="mypage-stats__item">
              <div class="mypage-stats__item-head">
                <span class="mypage-stats__book-title"><%= book_summary[:title] %></span>
                <span class="mypage-stats__book-pages"><%= pages_read %> ページ</span>
              </div>
              <div class="mypage-stats__bar" role="img" aria-label="<%= book_summary[:title] %> の読了ページ割合">
                <span class="mypage-stats__bar-fill" style="width: <%= ratio %>%"></span>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="mypage-stats__breakdown mypage-stats__category-section">
      <h2 class="mypage-stats__breakdown-title">種類別読書ポートフォリオ</h2>

      <% if @summary[:categories].empty? %>
        <p class="mypage-stats__empty">この期間の読書記録はありません。</p>
      <% else %>
        <%
          colors = {
            'other' => '#8b5cf6',         # バイオレット
            'literature' => '#3b82f6',    # ブルー
            'entertainment' => '#ec4899', # ピンク
            'technical' => '#10b981',     # エメラルド
            'manga' => '#f59e0b',         # アンバー
            'essay' => '#14b8a6',         # ティール
            'practical' => '#f43f5e',     # ローズ
            'magazine' => '#06b6d4',      # シアン
            'academic' => '#6366f1',      # インディゴ
            'non_fiction' => '#f97316',   # オレンジ
            'humanities' => '#6b7280'     # グレー
          }

          conic_pieces = []
          current_percent = 0.0

          @summary[:categories].each do |cat|
            key = cat[:key]
            color = colors[key.to_s] || '#6b7280'
            start_pct = current_percent
            end_pct = current_percent + cat[:ratio]
            conic_pieces << "#{color} #{start_pct}% #{end_pct}%"
            current_percent = end_pct
          end

          conic_style = "background: conic-gradient(#{conic_pieces.join(', ')});"
        %>
        <div class="mypage-stats__chart-container">
          <div class="mypage-stats__pie-chart" style="<%= conic_style %>" role="img" aria-label="種類別読了ページ割合の円グラフ"></div>
          <div class="mypage-stats__chart-legend">
            <ul class="mypage-stats__legend-list">
              <% @summary[:categories].each do |cat| %>
                <% key = cat[:key] %>
                <% color = colors[key.to_s] || '#6b7280' %>
                <li class="mypage-stats__legend-item">
                  <span class="mypage-stats__legend-color" style="background-color: <%= color %>"></span>
                  <span class="mypage-stats__legend-label"><%= cat[:name] %></span>
                  <span class="mypage-stats__legend-value"><%= cat[:pages_read] %> ページ (<%= cat[:ratio] %>%)</span>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
    </section>

    <section class="mypage-stats__log-details">
      <h2 class="mypage-stats__breakdown-title">読書ログ詳細</h2>

      <% if @summary[:reading_log_details].empty? %>
        <p class="mypage-stats__empty">この期間の読書記録はありません。</p>
      <% else %>
        <div class="mypage-stats__log-table-wrap">
          <table class="mypage-stats__log-table">
            <thead>
              <tr>
                <th class="mypage-stats__log-th" scope="col">日付</th>
                <th class="mypage-stats__log-th" scope="col">書籍名</th>
                <th class="mypage-stats__log-th" scope="col">開始ページ</th>
                <th class="mypage-stats__log-th" scope="col">終了ページ</th>
                <th class="mypage-stats__log-th" scope="col">読了ページ数</th>
              </tr>
            </thead>
            <tbody>
              <% @summary[:reading_log_details].each do |log| %>
                <tr class="mypage-stats__log-row">
                  <td class="mypage-stats__log-td"><%= l(log[:read_at], format: :default) %></td>
                  <td class="mypage-stats__log-td"><%= log[:book_title] %></td>
                  <td class="mypage-stats__log-td"><%= log[:start_page].present? ? "#{log[:start_page]}ページ" : "-" %></td>
                  <td class="mypage-stats__log-td"><%= log[:end_page].present? ? "#{log[:end_page]}ページ" : "-" %></td>
                  <td class="mypage-stats__log-td"><%= log[:pages_read] %>ページ</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>
  </div>
</section>

