<% content_for :title, "メールアドレスの変更 | Yomikiri" %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-card__header">
      <%= link_to 'Yomikiri', root_path, class: 'auth-card__logo' %>
      <h1 class="auth-card__title">メールアドレスの変更</h1>
      <p class="auth-card__subtitle">本人確認のため、現在のパスワードを入力してください。</p>
    </div>

    <% if current_user.errors.any? %>
      <div class="auth-card__errors" role="alert">
        <ul>
          <% current_user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with url: email_change_path, method: :patch, local: true do |f| %>
      <div class="auth-card__body">
        <div class="form-group">
          <%= label_tag :email, '新しいメールアドレス', class: 'form-label' %>
          <%= email_field_tag :email, nil,
                autofocus: true,
                autocomplete: 'email',
                class: 'form-input',
                placeholder: 'new@example.com',
                required: true %>
        </div>

        <div class="form-group">
          <%= label_tag :current_password, '現在のパスワード', class: 'form-label' %>
          <%= password_field_tag :current_password, nil,
                autocomplete: 'current-password',
                class: 'form-input',
                placeholder: '現在のパスワードを入力',
                required: true %>
        </div>

        <%= f.submit '確認メールを送信', class: 'btn btn--primary btn--full-width' %>
      </div>
    <% end %>

    <div class="auth-card__footer">
      <%= link_to '← マイページに戻る', mypage_path, class: 'auth-card__link' %>
    </div>
  </div>
</div>
