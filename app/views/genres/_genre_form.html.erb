<%# ジャンル追加フォーム %>
<%= form_with model: [genre], url: mypage_genres_path, class: "genre-add-form" do |f| %>
  <% if genre.errors.any? %>
    <div class="genre-add-form__errors" role="alert">
      <ul>
        <% genre.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="genre-add-form__row">
    <%= f.text_field :name,
          placeholder: "例: SF、Web開発、マインドセット",
          class: "genre-add-form__input",
          maxlength: 30,
          id: "genre_name_input",
          autocomplete: "off" %>
    <%= f.submit "追加", class: "btn btn--primary btn--sm" %>
  </div>
<% end %>
