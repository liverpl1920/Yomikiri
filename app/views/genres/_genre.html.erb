<%# ジャンル1件の表示行 %>
<%= turbo_frame_tag dom_id(genre) do %>
  <li class="genre-list__item">
    <span class="genre-list__name"><%= genre.name %></span>
    <div class="genre-list__actions">
      <%= link_to "編集",
            edit_mypage_genre_path(genre),
            class: "btn btn--outline btn--xs",
            data: { turbo_frame: dom_id(genre) } %>
      <%= button_to "削除",
            mypage_genre_path(genre),
            method: :delete,
            class: "btn btn--danger-outline btn--xs",
            form: { data: { turbo_confirm: "「#{genre.name}」を削除しますか？" } } %>
    </div>
  </li>
<% end %>
