<% content_for :title, "メモ編集 | #{@book.title} | Yomikiri" %>

<div class="container">
  <div class="book-show">
    <h1 class="book-show__memo-title">メモを編集する</h1>
    <p class="book-show__subtitle"><%= @book.title %></p>

    <% if @book_memo.errors.any? %>
      <div class="form-errors" role="alert">
        <ul class="form-errors__list">
          <% @book_memo.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: [@book, @book_memo], data: { turbo: false, controller: 'memo-format' } do |f| %>
      <div class="book-show__memo-field">
        <%= f.label :page_number, '対象ページ（任意）', class: 'book-show__memo-label' %>
        <%= f.text_field :page_number,
              class: 'book-show__memo-page-input',
              maxlength: BookMemo::PAGE_NUMBER_MAX_LENGTH,
              placeholder: '例: 100、100-120、p.200' %>
        <small class="book-show__memo-help">最大20文字</small>
      </div>
      <div class="book-show__memo-field">
        <%= f.label :content, 'メモ内容', class: 'book-show__memo-label' %>
        <div class="book-show__memo-toolbar" role="group" aria-label="メモ装飾ツール">
          <div class="book-show__memo-toolbar-group">
            <%= button_tag '太字',
                  type: 'button',
                  class: 'btn btn--secondary btn--sm',
                  data: { action: 'memo-format#insertBold' } %>
          </div>
          <div class="book-show__memo-toolbar-group">
            <label for="edit-book-memo-color" class="book-show__memo-label">文字色</label>
            <input id="edit-book-memo-color"
                   type="color"
                   value="#dc2626"
                   class="book-show__memo-color-input"
                   data-memo-format-target="color">
            <%= button_tag '色を適用',
                  type: 'button',
                  class: 'btn btn--secondary btn--sm',
                  data: { action: 'memo-format#insertColor' } %>
          </div>
        </div>
        <%= f.text_area :content,
              class: 'book-show__memo-input',
              rows: 6,
              maxlength: BookMemo::CONTENT_MAX_LENGTH,
              placeholder: '読書中の気づきや記録を編集できます',
              data: { memo_format_target: 'textarea' } %>
        <small class="book-show__memo-help">最大2000文字（太字: **テキスト** / 色: [color=#ff0000]テキスト[/color]）</small>
      </div>
      <div class="book-show__memo-actions">
        <%= f.submit 'メモを更新する', class: 'btn btn--primary' %>
        <%= link_to 'キャンセル', book_path(@book), class: 'btn btn--outline' %>
      </div>
    <% end %>
  </div>
</div>
